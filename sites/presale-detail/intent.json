{
  "slug": "presale-detail",
  "name": "Pre-Sale Detail (for Zane & Darren)",
  "host": "presale-detail.vercel.app",
  "path_prefix": "/",
  "repo": "~/Desktop/presale-detail",
  "source_file": "scripts/page.html",
  "source_commit": "85e6692",
  "note": "site/index.html is generated by scripts/build.py from scripts/page.html; fixes go in page.html.",
  "job": "Two people who detail cars and boats want one private seller to contact today, with the price and a message ready to send.",
  "steps": [
    {
      "id": "land",
      "label": "Opens the page",
      "source": "scripts/page.html:97 (h1, filled by render() at :141)",
      "match": [
        {
          "kind": "pageview",
          "path": "/"
        }
      ]
    },
    {
      "id": "read_cards",
      "label": "Scrolls into the job cards",
      "source": "scripts/page.html:103 (main#list), card markup :124-136",
      "match": [
        {
          "kind": "scroll_px",
          "min": 600
        },
        {
          "kind": "event",
          "event": "copy",
          "decides_miss": false
        },
        {
          "kind": "event",
          "event": "link_click",
          "decides_miss": false
        },
        {
          "kind": "event",
          "event": "button",
          "prop": "id",
          "equals": "Copy message",
          "decides_miss": false
        }
      ],
      "note": "180 cards make the page ~100k px tall, so scroll_depth/max_depth percentages stay at 0 even after 3,785px (S3, 2026-10-10). Only rrweb scrollY, or an interaction on a card, proves this step."
    },
    {
      "id": "copy",
      "label": "Copies a ready message",
      "source": "scripts/page.html:135 (button.copy), handler :161-167",
      "match": [
        {
          "kind": "event",
          "event": "copy"
        },
        {
          "kind": "click",
          "any": [
            "button.copy",
            "Copy message"
          ]
        }
      ]
    },
    {
      "id": "contact",
      "label": "Opens the listing to send it (Open listing / Message seller)",
      "source": "scripts/page.html:135 (a[data-open]), contact line :115-119",
      "match": [
        {
          "kind": "event",
          "event": "link_click",
          "prop": "href",
          "contains": [
            "craigslist.org",
            "facebook.com"
          ]
        },
        {
          "kind": "click",
          "any": [
            "Open listing",
            "Message seller"
          ]
        }
      ]
    }
  ],
  "success": "contact",
  "known_exits": [
    "leaving to craigslist.org or facebook.com via the card link is success",
    "Your prices (#ratesBtn, :96) is a side path, not an exit"
  ]
}
